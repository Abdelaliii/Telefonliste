        }
        lines {
          text: "    function saveContacts(data) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));"
