    model_usage {
      input_tokens: 66285
      output_tokens: 2402
      message_id: "EuZpat_1DuutqtsPqeK9oA4"
      thinking_output_tokens: 1369
      response_output_tokens: 1033
      response_id: "EuZpat_1DuutqtsPqeK9oA4"
    }
    generator_model: MODEL_GOOGLE_GEMINI_INTERNAL_BYOM
    execution_id: "05dad704-20e0-4fe1-9125-25ec9b43fa51"
    source_trajectory_step_info {
      trajectory_id: "05dad704-20e0-4fe1-9125-25ec9b43fa51"
