TIAL_CONTACTS);\n      return INITIAL_CONTACTS;\n    }\n    const parsed = JSON.parse(raw);\n    if (Array.isArray(parsed) && parsed.length > 0) {\n      return parsed;\n    }\n  } catch (err) {\n    console.error(\'Failed to parse stored contacts, loading defaults:\', err);\n  }\n  saveContactsToStorage(INITIAL_CONTACTS);\n  return INITIAL_CONTACTS;\n}\n\nexport function saveContactsToStorage(contacts: Contact[]): void {\n  try {\n    localStorage.setItem(CONTACTS_KEY, JSON.stringify(contacts));\n  } catch (err) {\n    console.error(\'Failed to save contacts to localStorage:\', err);\n  }\n}\n\nexport function loadMasterDataFromStorage(): MasterData {\n  try {\n    const raw = localStorage.getItem(MASTERDATA_KEY);\n    if (raw) {\n      const parsed = JSON.parse(raw);\n      if (parsed && Array.isArray(parsed.standorte) && Array.isArray(parsed.abteilungen)) {\n        return parsed;\n      }\n    }\n  } catch (err) {\n    console.error(\'Failed to parse master data, fallback to defaults:\', err);\n  }\n  const defaultMaster: MasterData = {\n    standorte: INITIAL_STANDORTE,\n    abteilungen: INITIAL_ABTEILUNGEN,\n  };\n  saveMasterDataToStorage(defaultMaster);\n  return defaultMaster;\n}\n\nexport function saveMasterDataToStorage(masterData: MasterData): void {\n  try {\n    localStorage.setItem(MASTERDATA_KEY, JSON.stringify(masterData));\n  } catch (err) {\n    console.error(\'Failed to save master data to localStorage:\', err);\n  }\n}\n\nexport function exportContactsToJson(contacts: Contact[], masterData?: MasterData): void {\n  const payload = {\n    contacts,\n    masterData: masterData || loadMasterDataFromStorage(),\n    exportedAt: new Date().toISOString(),\n  };\n  const dataStr = \'data:text/json;charset=utf-8,\' + encodeURIComponent(JSON.stringify(payload, null, 2));\n  const downloadAnchor = document.createElement(\'a\');\n  downloadAnchor.setAttribute(\'href\', dataStr);\n  downloadAnchor.setAttribute(\'download\', `Telefonverzeichnis_Export_${new Date().toISOString().slice(0, 10)}.json`);\n  document.body.appendChild(downloadAnchor);\n  downloadAnchor.click();\n  downloadAnchor.remove();\n}\n\nexport function generateVCard(contact: Contact): string {\n  return [\n    \'BEGIN:VCARD\',\n    \'VERSION:3.0\',\n    `N:${contact.nachname};${contact.vorname};;;`,\n    `FN:${contact.vorname} ${contact.nachname}`,\n    `ORG:${contact.standort};${contact.abteilung}`,\n    `TITLE:${contact.position}`,\n    `TEL;TYPE=WORK,VOICE:${contact.festnetz}`,\n    contact.mobil ? `TEL;TYPE=CELL,VOICE:${contact.mobil}` : \'\',\n    `EMAIL;TYPE=PREF,INTERNET:${contact.email}`,\n    contact.raum ? `NOTE:Ort: ${contact.raum} - ${contact.notizen || \'\'}` : `NOTE:${contact.notizen || \'\'}`,\n    \'END:VCARD\'\n  ].filter(Boolean).join(\'\\n\');\n}\nThe following action was requested:\nCreate file /src/components/MasterDataModal.tsxThe action produced the following result:\nSuccessfully created file /src/components/MasterDataModal.tsx with content:\nimport React, { useState } from \'react\';\nimport { X, Plus, Trash2, Database, MapPin, Building2, Sparkles } from \'lucide-react\';\nimport { MasterData, Contact } from \'../types\';\n\ninterface MasterDataModalProps {\n  isOpen: boolean;\n  masterData: MasterData;\n  contacts: Contact[];\n  onClose: () => void;\n  onSaveMasterData: (updated: MasterData) => void;\n  onSyncFromContacts: () => void;\n}\n\nexport const MasterDataModal: React.FC<MasterDataModalProps> = ({\n  isOpen,\n  masterData,\n  contacts,\n  onClose,\n  onSaveMasterData,\n  onSyncFromContacts,\n}) => {\n  const [activeTab, setActiveTab] = useState<\'standorte\' | \'abteilungen\'>(\'standorte\');\n  const [newItemText, setNewItemText] = useState(\'\');\n\n  if (!isOpen) return null;\n\n  const handleAddItem = (e: React.FormEvent) => {\n    e.preventDefault();\n    const val = newItemText.trim();\n    if (!val) return;\n\n    if (activeTab === \'standorte\') {\n      if (masterData.standorte.includes(val)) {\n        alert(\'Dieser Standort existiert bereits.\');\n        return;\n      }\n      onSaveMasterData({\n        ...masterData,\n        standorte: [...masterData.standorte, val].sort(),\n      });\n    } else {\n      if (masterData.abteilungen.includes(val)) {\n        alert(\'Diese Abteilung existiert bereits.\');\n        return;\n      }\n      onSaveMasterData({\n        ...masterData,\n        abteilungen: [...masterData.abteilungen, val].sort(),\n      });\n    }\n    setNewItemText(\'\');\n  };\n\n  const handleDeleteItem = (itemToDelete: string) => {\n    if (activeTab === \'standorte\') {\n      const count = contacts.filter((c) => c.standort === itemToDelete).length;\n      if (count > 0 && !confirm(`Der Standort \"${itemToDelete}\" wird aktuell von ${count} Kontakten verwendet. Wirklich aus den Stammdaten entfernen?`)) {\n        return;\n      }\n      onSaveMasterData({\n        ...masterData,\n        standorte: masterData.standorte.filter((s) => s !== itemToDelete),\n      });\n    } else {\n      const count = contacts.filter((c) => c.abteilung === itemToDelete).length;\n      if (count > 0 && !confirm(`Die Abteilung \"${itemToDelete}\" wird aktuell von ${count} Kontakten verwendet. Wirklich aus den Stammdaten entfernen?`)) {\n        return;\n      }\n      onSaveMasterData({\n        ...masterData,\n        abteilungen: masterData.abteilungen.filter((a) => a !== itemToDelete),\n      });\n    }\n  };\n\n  return (\n    <div className=\"fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 overflow-y-auto no-print\">\n      <div className=\"bg-white rounded-2xl max-w-xl w-full p-6 shadow-2xl border border-slate-200 my-8 animate-in fade-in zoom-in-95 duration-150\">\n        \n        {/* Header */}\n        <div className=\"flex justify-between items-center pb-4 border-b border-slate-100\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"p-2.5 bg-blue-50 text-blue-600 rounded-xl\">\n              <Database className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h2 className=\"text-lg font-bold text-slate-900\">\n                Zentrale Stammdaten-Verwaltung\n              </h2>\n              <p className=\"text-xs text-slate-500\">\n                Pflege der vordefinierten Standorte und Abteilungen zur Gew\303\244hrleistung der Datenqualit\303\244t\n              </p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"text-slate-400 hover:text-slate-600 p-1.5 rounded-lg hover:bg-slate-100 transition\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Sync Button */}\n        <div className=\"mt-4 p-3 bg-indigo-50/80 border border-indigo-200/80 rounded-xl flex items-center justify-between text-xs text-indigo-900\">\n          <div className=\"flex items-center gap-2\">\n            <Sparkles className=\"w-4 h-4 text-indigo-600 shrink-0\" />\n            <span>Fehlende Werte aus Kontaktdaten automatisch erg\303\244nzen?</span>\n          </div>\n          <button\n            onClick={onSyncFromContacts}\n            className=\"px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-semibold transition shrink-0\"\n          >\n            Jetzt abgleichen\n          </button>\n        </div>\n\n        {/* Tab switcher */}\n        <div className=\"flex items-center gap-2 mt-5 border-b border-slate-200\">\n          <button\n            onClick={() => {\n              setActiveTab(\'standorte\');\n              setNewItemText(\'\');\n            }}\n            className={`pb-2.5 px-3 text-xs sm:text-sm font-semibold flex items-center gap-1.5 border-b-2 transition ${\n              activeTab === \'standorte\'\n                ? \'border-blue-600 text-blue-600\'\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\n            }`}\n          >\n            <MapPin className=\"w-4 h-4\" />\n            <span>Standorte ({masterData.standorte.length})</span>\n          </button>\n\n          <button\n            onClick={() => {\n              setActiveTab(\'abteilungen\');\n              setNewItemText(\'\');\n            }}\n            className={`pb-2.5 px-3 text-xs sm:text-sm font-semibold flex items-center gap-1.5 border-b-2 transition ${\n              activeTab === \'abteilungen\'\n                ? \'border-blue-600 text-blue-600\'\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\n            }`}\n          >\n            <Building2 className=\"w-4 h-4\" />\n            <span>Abteilungen ({masterData.abteilungen.length})</span>\n          </button>\n        </div>\n\n        {/* Form to add item */}\n        <form onSubmit={handleAddItem} className=\"flex gap-2 my-4\">\n          <input\n            type=\"text\"\n            required\n            value={newItemText}\n            onChange={(e) => setNewItemText(e.target.value)}\n            placeholder={activeTab === \'standorte\' ? \'Neuen Standort eintragen...\' : \'Neue Abteilung eintragen...\'}\n            className=\"flex-1 px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition\"\n          />\n          <button\n            type=\"submit\"\n            className=\"px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white rounded-xl text-xs sm:text-sm font-semibold transition flex items-center gap-1 shrink-0\"\n          >\n            <Plus className=\"w-4 h-4\" /> Hinzuf\303\274gen\n          </button>\n        </form>\n\n        {/* List of current items */}\n        <div className=\"max-h-60 overflow-y-auto border border-slate-200 rounded-xl divide-y divide-slate-100 bg-slate-50/50 p-1\">\n          {(activeTab === \'standorte\' ? masterData.standorte : masterData.abteilungen).map((item) => {\n            const usageCount = contacts.filter((c) =>\n              activeTab === \'standorte\' ? c.standort === item : c.abteilung === item\n            ).length;\n\n            return (\n              <div\n                key={item}\n                className=\"flex items-center justify-between px-3 py-2 hover:bg-white rounded-lg transition text-xs sm:text-sm text-slate-800\"\n              >\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"font-medium\">{item}</span>\n                  {usageCount > 0 && (\n                    <span className=\"px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-200 text-slate-700\">\n                      {usageCount} Kontakte\n                    </span>\n                  )}\n                </div>\n                <button\n                  onClick={() => handleDeleteItem(item)}\n                  className=\"p-1 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded transition\"\n                  title=\"Eintrag entfernen\"\n                >\n                  <Trash2 className=\"w-4 h-4\" />\n                </button>\n              </div>\n            );\n          })}\n        </div>\n\n        {/* Footer */}\n        <div className=\"flex justify-end pt-4 mt-4 border-t border-slate-100\">\n          <button\n            onClick={onClose}\n            className=\"px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs sm:text-sm font-semibold transition\"\n          >\n            Fertigstellen & Schlie\303\237en\n          </button>\n        </div>\n\n      </div>\n    </div>\n  );\n};\nThe following action was requested:\nView contents of file /src/components/ContactModal.tsx from lines 1 to 180The action produced the following result:\nFile Path: `/src/components/ContactModal.tsx`\nTotal Lines: 257\nTotal Bytes: 9691\nShowing lines 1 to 180\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes