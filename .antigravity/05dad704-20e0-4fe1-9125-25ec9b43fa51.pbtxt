  file_change {
    absolute_path_uri: "file:///src/App.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useState, useEffect, useMemo } from \'react\';\nimport { Header } from \'./components/Header\';\nimport { SearchAndFilters } from \'./components/SearchAndFilters\';\nimport { ContactTable } from \'./components/ContactTable\';\nimport { ContactGrid } from \'./components/ContactGrid\';\nimport { ContactGrouped } from \'./components/ContactGrouped\';\nimport { ContactModal } from \'./components/ContactModal\';\nimport { ImportExportModal } from \'./components/ImportExportModal\';\nimport { VCardModal } from \'./components/VCardModal\';\nimport { DeleteConfirmModal } from \'./components/DeleteConfirmModal\';\nimport { ToastContainer, ToastMessage } from \'./components/Toast\';\n\nimport { Contact, FilterState, ViewMode, SortField, SortOrder } from \'./types\';\nimport { loadContactsFromStorage, saveContactsToStorage, exportContactsToJson } from \'./lib/storage\';\nimport { generateStandaloneHtml } from \'./lib/standaloneHtmlGenerator\';\nimport { INITIAL_CONTACTS } from \'./data/initialContacts\';\nimport { Contact as ContactIcon, Plus, Building2 } from \'lucide-react\';\n\nexport default function App() {\n  // Contacts State\n  const [contacts, setContacts] = useState<Contact[]>(() => loadContactsFromStorage());\n\n  // View Mode\n  const [viewMode, setViewMode] = useState<ViewMode>(\'table\');\n\n  // Sorting\n  const [sortField, setSortField] = useState<SortField>(\'nachname\');\n  const [sortOrder, setSortOrder] = useState<SortOrder>(\'asc\');\n\n  // Filters\n  const [filters, setFilters] = useState<FilterState>({\n    searchQuery: \'\',\n    selectedStandort: \'\',\n    selectedAbteilung: \'\',\n    onlyFavorites: false,\n    alphabetFilter: \'\',\n  });\n\n  // Toast Notifications\n  const [toasts, setToasts] = useState<ToastMessage[]>([]);\n\n  // Modals State\n  const [isContactModalOpen, setIsContactModalOpen] = useState(false);\n  const [editingContact, setEditingContact] = useState<Contact | null>(null);\n\n  const [isImportExportModalOpen, setIsImportExportModalOpen] = useState(false);\n  const [vCardContact, setVCardContact] = useState<Contact | null>(null);\n  const [deletingContact, setDeletingContact] = useState<Contact | null>(null);\n\n  // Sync state to LocalStorage\n  useEffect(() => {\n    saveContactsToStorage(contacts);\n  }, [contacts]);\n\n  // Add toast helper\n  const addToast = (message: string, type: \'success\' | \'error\' | \'info\' = \'success\') => {\n    const id = Date.now().toString() + Math.random().toString(36).substring(2, 5);\n    setToasts((prev) => [...prev, { id, message, type }]);\n    setTimeout(() => {\n      setToasts((prev) => prev.filter((t) => t.id !== id));\n    }, 3000);\n  };\n\n  const dismissToast = (id: string) => {\n    setToasts((prev) => prev.filter((t) => t.id !== id));\n  };\n\n  // Extract unique locations and departments\n  const allStandorte = useMemo(() => {\n    const set = new Set<string>();\n    contacts.forEach((c) => {\n      if (c.standort) set.add(c.standort);\n    });\n    return Array.from(set).sort();\n  }, [contacts]);\n\n  const allAbteilungen = useMemo(() => {\n    const set = new Set<string>();\n    contacts.forEach((c) => {\n      if (c.abteilung) set.add(c.abteilung);\n    });\n    return Array.from(set).sort();\n  }, [contacts]);\n\n  // Filter & Sort Logic\n  const filteredAndSortedContacts = useMemo(() => {\n    let result = [...contacts];\n\n    // Filter by Search Query\n    if (filters.searchQuery.trim()) {\n      const q = filters.searchQuery.toLowerCase().trim();\n      result = result.filter((c) => {\n        const fullName = `${c.nachname} ${c.vorname}`.toLowerCase();\n        const reverseName = `${c.vorname} ${c.nachname}`.toLowerCase();\n        return (\n          fullName.includes(q) ||\n          reverseName.includes(q) ||\n          (c.position || \'\').toLowerCase().includes(q) ||\n          (c.abteilung || \'\').toLowerCase().includes(q) ||\n          (c.standort || \'\').toLowerCase().includes(q) ||\n          (c.festnetz || \'\').toLowerCase().includes(q) ||\n          (c.mobil || \'\').toLowerCase().includes(q) ||\n          (c.email || \'\').toLowerCase().includes(q) ||\n          (c.raum || \'\').toLowerCase().includes(q) ||\n          (c.notizen || \'\').toLowerCase().includes(q)\n        );\n      });\n    }\n\n    // Filter by Location\n    if (filters.selectedStandort) {\n      result = result.filter((c) => c.standort === filters.selectedStandort);\n    }\n\n    // Filter by Department\n    if (filters.selectedAbteilung) {\n      result = result.filter((c) => c.abteilung === filters.selectedAbteilung);\n    }\n\n    // Filter by Favorites\n    if (filters.onlyFavorites) {\n      result = result.filter((c) => c.isFavorite);\n    }\n\n    // Filter by Initial Letter\n    if (filters.alphabetFilter) {\n      const char = filters.alphabetFilter.toUpperCase();\n      result = result.filter((c) => c.nachname.toUpperCase().startsWith(char));\n    }\n\n    // Sort Result\n    result.sort((a, b) => {\n      let valA = (a[sortField] || \'\').toString().toLowerCase();\n      let valB = (b[sortField] || \'\').toString().toLowerCase();\n\n      if (valA < valB) return sortOrder === \'asc\' ? -1 : 1;\n      if (valA > valB) return sortOrder === \'asc\' ? 1 : -1;\n      return 0;\n    });\n\n    return result;\n  }, [contacts, filters, sortField, sortOrder]);\n\n  // Handlers\n  const handleSort = (field: SortField) => {\n    if (sortField === field) {\n      setSortOrder((prev) => (prev === \'asc\' ? \'desc\' : \'asc\'));\n    } else {\n      setSortField(field);\n      setSortOrder(\'asc\');\n    }\n  };\n\n  const handleFilterChange = (updated: Partial<FilterState>) => {\n    setFilters((prev) => ({ ...prev, ...updated }));\n  };\n\n  const handleResetFilters = () => {\n    setFilters({\n      searchQuery: \'\',\n      selectedStandort: \'\',\n      selectedAbteilung: \'\',\n      onlyFavorites: false,\n      alphabetFilter: \'\',\n    });\n  };\n\n  const handleSaveContact = (contactData: Omit<Contact, \'id\'> & { id?: string }) => {\n    if (contactData.id) {\n      // Update\n      setContacts((prev) =>\n        prev.map((item) => (item.id === contactData.id ? (contactData as Contact) : item))\n      );\n      addToast(`Kontakt ${contactData.nachname}, ${contactData.vorname} erfolgreich aktualisiert.`);\n    } else {\n      // Create new\n      const newContact: Contact = {\n        ...contactData,\n        id: `c-${Date.now()}`,\n      };\n      setContacts((prev) => [newContact, ...prev]);\n      addToast(`Kontakt ${newContact.nachname}, ${newContact.vorname} neu angelegt.`);\n    }\n    setIsContactModalOpen(false);\n    setEditingContact(null);\n  };\n\n  const handleDeleteConfirm = (id: string) => {\n    const target = contacts.find((c) => c.id === id);\n    setContacts((prev) => prev.filter((c) => c.id !== id));\n    setDeletingContact(null);\n    if (target) {\n      addToast(`Kontakt ${target.nachname}, ${target.vorname} gel\303\266scht.`, \'info\');\n    }\n  };\n\n  const handleToggleFavorite = (id: string) => {\n    setContacts((prev) =>\n      prev.map((c) => {\n        if (c.id === id) {\n          const updated = !c.isFavorite;\n          addToast(\n            updated ? `${c.nachname} zu Favoriten hinzugef\303\274gt.` : `${c.nachname} aus Favoriten entfernt.`,\n            \'info\'\n          );\n          return { ...c, isFavorite: updated };\n        }\n        return c;\n      })\n    );\n  };\n\n  const handleCopy = (text: string, label: string) => {\n    navigator.clipboard.writeText(text);\n    addToast(`${label} in Zwischenablage kopiert!`);\n  };\n\n  const handleDownloadStandaloneHtml = () => {\n    const htmlString = generateStandaloneHtml(contacts, \'Telefon- und Kontaktverzeichnis\');\n    const blob = new Blob([htmlString], { type: \'text/html;charset=utf-8\' });\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement(\'a\');\n    a.href = url;\n    a.download = `Telefonverzeichnis_Verwaltung_${new Date().toISOString().slice(0, 10)}.html`;\n    document.body.appendChild(a);\n    a.click();\n    document.body.removeChild(a);\n    URL.revokeObjectURL(a);\n    addToast(\'Standalone HTML-Datei erfolgreich heruntergeladen!\');\n  };\n\n  const handleExportJson = () => {\n    exportContactsToJson(contacts);\n    addToast(`${contacts.length} Kontakte als JSON gesichert.`);\n  };\n\n  const handleImportJson = (importedContacts: Contact[], mode: \'replace\' | \'merge\') => {\n    if (mode === \'replace\') {\n      setContacts(importedContacts);\n      addToast(`${importedContacts.length} Kontakte importiert (Ersetzt).`);\n    } else {\n      // Merge by ID or unique name/email\n      const existingIds = new Set(contacts.map((c) => c.id));\n      const newItems = importedContacts.filter((c) => !existingIds.has(c.id));\n      setContacts((prev) => [...newItems, ...prev]);\n      addToast(`${newItems.length} neue Kontakte zusammengef\303\274hrt.`);\n    }\n  };\n\n  const handleResetSampleData = () => {\n    if (\n      window.confirm(\n        \'M\303\266chten Sie das Telefonverzeichnis wirklich auf die urspr\303\274nglichen 8 Beispieldaten zur\303\274cksetzen? Alle bisherigen \303\204nderungen werden \303\274berschrieben.\'\n      )\n    ) {\n      setContacts(INITIAL_CONTACTS);\n      handleResetFilters();\n      addToast(\'Telefonverzeichnis auf Beispieldaten zur\303\274ckgesetzt.\', \'info\');\n    }\n  };\n\n  const handlePrint = () => {\n    window.print();\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 text-slate-800 flex flex-col font-sans antialiased selection:bg-blue-100 selection:text-blue-900\">\n      \n      {/* Toast Notifications */}\n      <ToastContainer toasts={toasts} onDismiss={dismissToast} />\n\n      {/* Printable Header - Visible ONLY when printing */}\n      <div className=\"hidden print:block p-4 border-b border-slate-300 mb-4\">\n        <div className=\"flex justify-between items-center\">\n          <div>\n            <h1 className=\"text-xl font-bold text-black\">Telefon- und Kontaktverzeichnis</h1>\n            <p className=\"text-xs text-slate-600\">Verwaltungsausgabe \302\267 Stand: {new Date().toLocaleDateString(\'de-DE\')}</p>\n          </div>\n          <div className=\"text-right text-xs text-slate-500\">\n            Gesamt: {contacts.length} Kontakte\n          </div>\n        </div>\n      </div>\n\n      {/* Main App Header */}\n      <Header\n        totalContacts={contacts.length}\n        locationsCount={allStandorte.length}\n        onOpenAddModal={() => {\n          setEditingContact(null);\n          setIsContactModalOpen(true);\n        }}\n        onOpenImportExportModal={() => setIsImportExportModalOpen(true)}\n        onDownloadStandaloneHtml={handleDownloadStandaloneHtml}\n        onPrint={handlePrint}\n        onResetSampleData={handleResetSampleData}\n      />\n\n      {/* Main Content Area */}\n      <main className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-1 w-full\">\n        \n        {/* Search & Filter Bar */}\n        <SearchAndFilters\n          filters={filters}\n          onFilterChange={handleFilterChange}\n          allStandorte={allStandorte}\n          allAbteilungen={allAbteilungen}\n          viewMode={viewMode}\n          onViewModeChange={setViewMode}\n          filteredCount={filteredAndSortedContacts.length}\n          totalCount={contacts.length}\n          onResetFilters={handleResetFilters}\n        />\n\n        {/* Content Display (Table / Cards / Grouped / Empty State) */}\n        {filteredAndSortedContacts.length === 0 ? (\n          <div className=\"bg-white rounded-2xl p-12 text-center border border-slate-200 shadow-sm my-4\">\n            <div className=\"w-16 h-16 bg-blue-50 text-blue-500 rounded-2xl flex items-center justify-center mx-auto mb-4\">\n              <ContactIcon className=\"w-8 h-8\" />\n            </div>\n            <h3 className=\"text-lg font-bold text-slate-800\">Keine Kontakte gefunden</h3>\n            <p className=\"text-xs text-slate-500 mt-1 max-w-md mx-auto\">\n              {contacts.length === 0\n                ? \'Es befinden sich aktuell keine Kontakte im Verzeichnis.\'\n                : \'Es gibt keine Treffer f\303\274r deine ausgew\303\244hlten Suchkriterien oder Filter.\'}\n            </p>\n            <div className=\"flex flex-wrap items-center justify-center gap-3 mt-5\">\n              {contacts.length > 0 ? (\n                <button\n                  onClick={handleResetFilters}\n                  className=\"px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-semibold transition\"\n                >\n                  Filter zur\303\274cksetzen\n                </button>\n              ) : null}\n              <button\n                onClick={() => {\n                  setEditingContact(null);\n                  setIsContactModalOpen(true);\n                }}\n                className=\"px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white rounded-xl text-xs font-semibold transition flex items-center gap-1.5\"\n              >\n                <Plus className=\"w-4 h-4\" />\n                <span>Neuen Kontakt anlegen</span>\n              </button>\n            </div>\n          </div>\n        ) : (\n          <>\n            {viewMode === \'table\' && (\n              <ContactTable\n                contacts={filteredAndSortedContacts}\n                sortField={sortField}\n                sortOrder={sortOrder}\n                onSort={handleSort}\n                onEdit={(contact) => {\n                  setEditingContact(contact);\n                  setIsContactModalOpen(true);\n                }}\n                onDelete={(contact) => setDeletingContact(contact)}\n                onToggleFavorite={handleToggleFavorite}\n                onOpenVCard={(contact) => setVCardContact(contact)}\n                onCopy={handleCopy}\n              />\n            )}\n\n            {viewMode === \'cards\' && (\n              <ContactGrid\n                contacts={filteredAndSortedContacts}\n                onEdit={(contact) => {\n                  setEditingContact(contact);\n                  setIsContactModalOpen(true);\n                }}\n                onDelete={(contact) => setDeletingContact(contact)}\n                onToggleFavorite={handleToggleFavorite}\n                onOpenVCard={(contact) => setVCardContact(contact)}\n                onCopy={handleCopy}\n              />\n            )}\n\n            {viewMode === \'grouped\' && (\n              <ContactGrouped\n                contacts={filteredAndSortedContacts}\n                onEdit={(contact) => {\n                  setEditingContact(contact);\n                  setIsContactModalOpen(true);\n                }}\n                onDelete={(contact) => setDeletingContact(contact)}\n                onToggleFavorite={handleToggleFavorite}\n                onOpenVCard={(contact) => setVCardContact(contact)}\n                onCopy={handleCopy}\n              />\n            )}\n          </>\n        )}\n\n      </main>\n\n      {/* Footer */}\n      <footer className=\"bg-white border-t border-slate-200 py-4 text-center text-xs text-slate-500 no-print mt-auto\">\n        <div className=\"max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-2\">\n          <div className=\"flex items-center gap-2\">\n            <Building2 className=\"w-4 h-4 text-slate-400\" />\n            <span>Telefon- und Kontaktverzeichnis \302\267 Digitale Verwaltungsl\303\266sung</span>\n          </div>\n          <div>\n            Automatische Speicherung im lokalen Browser-Speicher (localStorage)\n          </div>\n        </div>\n      </footer>\n\n      {/* Modals */}\n      <ContactModal\n        isOpen={isContactModalOpen}\n        editingContact={editingContact}\n        allStandorte={allStandorte}\n        allAbteilungen={allAbteilungen}\n        onClose={() => {\n          setIsContactModalOpen(false);\n          setEditingContact(null);\n        }}\n        onSave={handleSaveContact}\n      />\n\n      <ImportExportModal\n        isOpen={isImportExportModalOpen}\n        contacts={contacts}\n        onClose={() => setIsImportExportModalOpen(false)}\n        onExportJson={handleExportJson}\n        onImportJson={handleImportJson}\n        onDownloadStandaloneHtml={handleDownloadStandaloneHtml}\n      />\n\n      <VCardModal\n        contact={vCardContact}\n        onClose={() => setVCardContact(null)}\n        onCopy={handleCopy}\n      />\n\n      <DeleteConfirmModal\n        contact={deletingContact}\n        onClose={() => setDeletingContact(null)}\n        onConfirm={handleDeleteConfirm}\n      />\n\n    </div>\n  );\n}\n"
    }
