  file_change {
    absolute_path_uri: "file:///src/components/ImportExportModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useRef, useState } from \'react\';\nimport { X, Download, Upload, Code2, CheckCircle2, FileText, Share2, Info } from \'lucide-react\';\nimport { Contact } from \'../types\';\n\ninterface ImportExportModalProps {\n  isOpen: boolean;\n  contacts: Contact[];\n  onClose: () => void;\n  onExportJson: () => void;\n  onImportJson: (importedContacts: Contact[], mode: \'replace\' | \'merge\') => void;\n  onDownloadStandaloneHtml: () => void;\n}\n\nexport const ImportExportModal: React.FC<ImportExportModalProps> = ({\n  isOpen,\n  contacts,\n  onClose,\n  onExportJson,\n  onImportJson,\n  onDownloadStandaloneHtml,\n}) => {\n  const fileInputRef = useRef<HTMLInputElement>(null);\n  const [importMode, setImportMode] = useState<\'replace\' | \'merge\'>(\'merge\');\n  const [importSuccessMessage, setImportSuccessMessage] = useState(\'\');\n\n  if (!isOpen) return null;\n\n  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (!file) return;\n\n    const reader = new FileReader();\n    reader.onload = (event) => {\n      try {\n        const raw = event.target?.result as string;\n        const parsed = JSON.parse(raw);\n        if (Array.isArray(parsed)) {\n          onImportJson(parsed, importMode);\n          setImportSuccessMessage(\n            `Erfolgreich ${parsed.length} Kontakte ${importMode === \'replace\' ? \'ersetzt\' : \'zusammengef\303\274hrt\'}!`\n          );\n          setTimeout(() => {\n            setImportSuccessMessage(\'\');\n            onClose();\n          }, 1800);\n        } else {\n          alert(\'Die gew\303\244hlte JSON-Datei enth\303\244lt kein g\303\274ltiges Kontakt-Array.\');\n        }\n      } catch (err: any) {\n        alert(\'Fehler beim Einlesen der JSON-Datei: \' + err.message);\n      }\n    };\n    reader.readAsText(file);\n    if (fileInputRef.current) fileInputRef.current.value = \'\';\n  };\n\n  return (\n    <div className=\"fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 overflow-y-auto no-print\">\n      <div className=\"bg-white rounded-2xl max-w-xl w-full p-6 shadow-2xl border border-slate-200 my-8 animate-in fade-in zoom-in-95 duration-150\">\n        \n        {/* Header */}\n        <div className=\"flex justify-between items-center pb-4 border-b border-slate-100\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"p-2.5 bg-indigo-50 text-indigo-600 rounded-xl\">\n              <Share2 className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h2 className=\"text-lg font-bold text-slate-900\">\n                Datenverwaltung & Netzlaufwerk-Export\n              </h2>\n              <p className=\"text-xs text-slate-500\">\n                Kontaktdaten sichern, austauschen oder als Standalone-Anwendung bereitstellen\n              </p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"text-slate-400 hover:text-slate-600 p-1.5 rounded-lg hover:bg-slate-100 transition\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {importSuccessMessage && (\n          <div className=\"mt-4 p-3 bg-emerald-50 border border-emerald-200 rounded-xl flex items-center gap-2 text-emerald-800 text-sm font-medium\">\n            <CheckCircle2 className=\"w-5 h-5 text-emerald-600 shrink-0\" />\n            <span>{importSuccessMessage}</span>\n          </div>\n        )}\n\n        <div className=\"space-y-6 pt-5\">\n          \n          {/* Section 1: JSON Export & Import */}\n          <div className=\"bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-3\">\n            <div className=\"flex items-center gap-2 text-slate-900 font-semibold text-sm\">\n              <FileText className=\"w-4 h-4 text-blue-600\" />\n              <span>JSON Datenbanksicherung ({contacts.length} Kontakte)</span>\n            </div>\n            <p className=\"text-xs text-slate-600 leading-relaxed\">\n              Exportiere die Kontaktdaten als JSON-Sicherungsdatei f\303\274r ein zentrales Netzlaufwerk oder importiere den aktuellen Stand von Kollegen.\n            </p>\n\n            <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 pt-1\">\n              {/* Export JSON */}\n              <button\n                onClick={onExportJson}\n                className=\"flex-1 bg-white hover:bg-slate-100 border border-slate-300 text-slate-800 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold transition flex items-center justify-center gap-2 shadow-sm\"\n              >\n                <Download className=\"w-4 h-4 text-blue-600\" />\n                <span>JSON Exportieren</span>\n              </button>\n\n              {/* Import JSON */}\n              <div className=\"flex-1 flex flex-col gap-1\">\n                <input\n                  type=\"file\"\n                  ref={fileInputRef}\n                  accept=\".json\"\n                  onChange={handleFileChange}\n                  className=\"hidden\"\n                />\n                <button\n                  onClick={() => fileInputRef.current?.click()}\n                  className=\"w-full bg-slate-900 hover:bg-slate-800 text-white px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold transition flex items-center justify-center gap-2 shadow-sm\"\n                >\n                  <Upload className=\"w-4 h-4 text-emerald-400\" />\n                  <span>JSON Importieren</span>\n                </button>\n              </div>\n            </div>\n\n            {/* Import options */}\n            <div className=\"flex items-center gap-4 text-xs text-slate-600 pt-2 border-t border-slate-200/60\">\n              <span className=\"font-medium text-slate-700\">Import-Modus:</span>\n              <label className=\"flex items-center gap-1.5 cursor-pointer\">\n                <input\n                  type=\"radio\"\n                  name=\"importMode\"\n                  checked={importMode === \'merge\'}\n                  onChange={() => setImportMode(\'merge\')}\n                  className=\"text-blue-600 focus:ring-blue-500\"\n                />\n                <span>Zusammenf\303\274hren (Erweitern)</span>\n              </label>\n              <label className=\"flex items-center gap-1.5 cursor-pointer\">\n                <input\n                  type=\"radio\"\n                  name=\"importMode\"\n                  checked={importMode === \'replace\'}\n                  onChange={() => setImportMode(\'replace\')}\n                  className=\"text-blue-600 focus:ring-blue-500\"\n                />\n                <span className=\"text-red-700 font-medium\">Alle Ersetzen</span>\n              </label>\n            </div>\n          </div>\n\n          {/* Section 2: Standalone Single HTML File Download */}\n          <div className=\"bg-amber-50/60 p-4 rounded-xl border border-amber-200 space-y-3\">\n            <div className=\"flex items-center gap-2 text-amber-900 font-semibold text-sm\">\n              <Code2 className=\"w-4 h-4 text-amber-600\" />\n              <span>Standalone HTML-Anwendung (.html)</span>\n            </div>\n            <p className=\"text-xs text-amber-800/90 leading-relaxed\">\n              Erzeugt eine <strong>komplett eigenst\303\244ndige .html-Datei</strong> inklusive allen aktuellen Kontakten, Suchfunktionen und Design. Diese Datei kann auf jedem gemeinsamen Netzlaufwerk (z.B. <code className=\"bg-amber-100 px-1 py-0.5 rounded text-[11px] font-mono\">X:\\Verwaltung\\Telefonliste.html</code>) abgelegt und von jedem Mitarbeiter per Doppelklick ge\303\266ffnet werden.\n            </p>\n\n            <button\n              onClick={onDownloadStandaloneHtml}\n              className=\"w-full bg-amber-600 hover:bg-amber-500 active:bg-amber-700 text-white px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition flex items-center justify-center gap-2 shadow-md shadow-amber-900/10\"\n            >\n              <Download className=\"w-4 h-4\" />\n              <span>Standalone Telefonverzeichnis.html herunterladen</span>\n            </button>\n          </div>\n\n          {/* Info notice */}\n          <div className=\"p-3 bg-blue-50 border border-blue-200/80 rounded-xl flex items-start gap-2.5 text-blue-900 text-xs\">\n            <Info className=\"w-4 h-4 text-blue-600 shrink-0 mt-0.5\" />\n            <div>\n              <strong>Hinweis f\303\274r die Verwaltung:</strong> Die Daten werden lokal im Browser (localStorage) gespeichert. \303\234ber den JSON Export/Import oder die Standalone-HTML Datei k\303\266nnen Sie Aktualisierungen im Team problemlos weitergeben.\n            </div>\n          </div>\n\n        </div>\n\n        {/* Modal Footer */}\n        <div className=\"flex justify-end pt-5 mt-4 border-t border-slate-100\">\n          <button\n            onClick={onClose}\n            className=\"px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs sm:text-sm font-semibold transition\"\n          >\n            Schlie\303\237en\n          </button>\n        </div>\n\n      </div>\n    </div>\n  );\n};\n"
    }
