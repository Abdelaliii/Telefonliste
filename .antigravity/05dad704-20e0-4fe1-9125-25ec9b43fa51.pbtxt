        lines {
          text: "    function importJson(event) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const file = event.target.files[0];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      if (!file) return;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const radios = document.getElementsByName(\'importMode\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      let mode = \'replace\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      for (let r of radios) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        if (r.checked) mode = r.value;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const reader = new FileReader();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      reader.onload = function(e) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        try {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          const imported = JSON.parse(e.target.result);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          if (Array.isArray(imported)) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            if (confirm(\\`M\303\266chten Sie \\${imported.length} Kontakte importieren? Vorhandene Daten werden \303\274berschrieben.\\`)) {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "              saveContacts(imported);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "              alert(\'Import erfolgreich abgeschlossen!\');"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            const current = getContacts();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            let result = [];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            if (mode === \'replace\') {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              if (confirm(\\`M\303\266chten Sie alle bestehenden Kontakte durch die \\${imported.length} importierten Kontakte ERSETZEN?\\`)) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                result = imported;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              } else {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                return;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            } else {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              // Merge"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              const existingIds = new Set(current.map(c => c.id));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              const newItems = imported.filter(c => !existingIds.has(c.id));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              result = [...current, ...newItems];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              alert(\\`\\${newItems.length} neue Kontakte wurden erfolgreich zusammengef\303\274hrt!\\`);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            saveContacts(result);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            closeImportExportModal();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            alert(\'Import erfolgreich abgeschlossen!\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          } else {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            alert(\'Ung\303\274ltiges Format: Die JSON-Datei muss ein Array von Kontakten enthalten.\');"
