      target_content: "  // Contacts State\n  const [contacts, setContacts] = useState<Contact[]>(() => loadContactsFromStorage());\n\n  // View Mode\n  const [viewMode, setViewMode] = useState<ViewMode>(\'table\');\n\n  // Sorting\n  const [sortField, setSortField] = useState<SortField>(\'nachname\');\n  const [sortOrder, setSortOrder] = useState<SortOrder>(\'asc\');\n\n  // Filters\n  const [filters, setFilters] = useState<FilterState>({\n    searchQuery: \'\',\n    selectedStandort: \'\',\n    selectedAbteilung: \'\',\n    onlyFavorites: false,\n    alphabetFilter: \'\',\n  });\n\n  // Toast Notifications\n  const [toasts, setToasts] = useState<ToastMessage[]>([]);\n\n  // Modals State\n  const [isContactModalOpen, setIsContactModalOpen] = useState(false);\n  const [editingContact, setEditingContact] = useState<Contact | null>(null);\n\n  const [isImportExportModalOpen, setIsImportExportModalOpen] = useState(false);\n  const [vCardContact, setVCardContact] = useState<Contact | null>(null);\n  const [deletingContact, setDeletingContact] = useState<Contact | null>(null);\n\n  // Sync state to LocalStorage\n  useEffect(() => {\n    saveContactsToStorage(contacts);\n  }, [contacts]);\n\n  // Add toast helper\n  const addToast = (message: string, type: \'success\' | \'error\' | \'info\' = \'success\') => {\n    const id = Date.now().toString() + Math.random().toString(36).substring(2, 5);\n    setToasts((prev) => [...prev, { id, message, type }]);\n    setTimeout(() => {\n      setToasts((prev) => prev.filter((t) => t.id !== id));\n    }, 3000);\n  };\n\n  const dismissToast = (id: string) => {\n    setToasts((prev) => prev.filter((t) => t.id !== id));\n  };\n\n  // Extract unique locations and departments\n  const allStandorte = useMemo(() => {\n    const set = new Set<string>();\n    contacts.forEach((c) => {\n      if (c.standort) set.add(c.standort);\n    });\n    return Array.from(set).sort();\n  }, [contacts]);\n\n  const allAbteilungen = useMemo(() => {\n    const set = new Set<string>();\n    contacts.forEach((c) => {\n      if (c.abteilung) set.add(c.abteilung);\n    });\n    return Array.from(set).sort();\n  }, [contacts]);"
      replacement_content: "  // Contacts State\n  const [contacts, setContacts] = useState<Contact[]>(() => loadContactsFromStorage());\n\n  // Master Data State (Standorte & Abteilungen)\n  const [masterStandorte, setMasterStandorte] = useState<string[]>(() => loadMasterStandorte());\n  const [masterAbteilungen, setMasterAbteilungen] = useState<string[]>(() => loadMasterAbteilungen());\n  const [isMasterDataModalOpen, setIsMasterDataModalOpen] = useState(false);\n\n  // View Mode\n  const [viewMode, setViewMode] = useState<ViewMode>(\'table\');\n\n  // Sorting\n  const [sortField, setSortField] = useState<SortField>(\'nachname\');\n  const [sortOrder, setSortOrder] = useState<SortOrder>(\'asc\');\n\n  // Filters\n  const [filters, setFilters] = useState<FilterState>({\n    searchQuery: \'\',\n    selectedStandort: \'\',\n    selectedAbteilung: \'\',\n    onlyFavorites: false,\n    alphabetFilter: \'\',\n  });\n\n  // Toast Notifications\n  const [toasts, setToasts] = useState<ToastMessage[]>([]);\n\n  // Modals State\n  const [isContactModalOpen, setIsContactModalOpen] = useState(false);\n  const [editingContact, setEditingContact] = useState<Contact | null>(null);\n\n  const [isImportExportModalOpen, setIsImportExportModalOpen] = useState(false);\n  const [vCardContact, setVCardContact] = useState<Contact | null>(null);\n  const [deletingContact, setDeletingContact] = useState<Contact | null>(null);\n\n  // Sync contacts to LocalStorage\n  useEffect(() => {\n    saveContactsToStorage(contacts);\n  }, [contacts]);\n\n  // Sync master data to LocalStorage\n  useEffect(() => {\n    saveMasterStandorte(masterStandorte);\n  }, [masterStandorte]);\n\n  useEffect(() => {\n    saveMasterAbteilungen(masterAbteilungen);\n  }, [masterAbteilungen]);\n\n  // Add toast helper\n  const addToast = (message: string, type: \'success\' | \'error\' | \'info\' = \'success\') => {\n    const id = Date.now().toString() + Math.random().toString(36).substring(2, 5);\n    setToasts((prev) => [...prev, { id, message, type }]);\n    setTimeout(() => {\n      setToasts((prev) => prev.filter((t) => t.id !== id));\n    }, 3000);\n  };\n\n  const dismissToast = (id: string) => {\n    setToasts((prev) => prev.filter((t) => t.id !== id));\n  };\n\n  // Master Data Handlers\n  const handleAddStandort = (name: string) => {\n    if (masterStandorte.includes(name)) {\n      addToast(`Standort \"${name}\" existiert bereits in den Stammdaten.`, \'info\');\n      return;\n    }\n    setMasterStandorte((prev) => [...prev, name].sort());\n    addToast(`Standort \"${name}\" zu Stammdaten hinzugef\303\274gt.`);\n  };\n\n  const handleUpdateStandort = (oldName: string, newName: string) => {\n    setMasterStandorte((prev) => prev.map((s) => (s === oldName ? newName : s)).sort());\n    setContacts((prev) =>\n      prev.map((c) => (c.standort === oldName ? { ...c, standort: newName } : c))\n    );\n    addToast(`Standort \"${oldName}\" in \"${newName}\" umbenannt.`);\n  };\n\n  const handleDeleteStandort = (name: string) => {\n    setMasterStandorte((prev) => prev.filter((s) => s !== name));\n    addToast(`Standort \"${name}\" aus Stammdaten entfernt.`, \'info\');\n  };\n\n  const handleAddAbteilung = (name: string) => {\n    if (masterAbteilungen.includes(name)) {\n      addToast(`Abteilung \"${name}\" existiert bereits in den Stammdaten.`, \'info\');\n      return;\n    }\n    setMasterAbteilungen((prev) => [...prev, name].sort());\n    addToast(`Abteilung \"${name}\" zu Stammdaten hinzugef\303\274gt.`);\n  };\n\n  const handleUpdateAbteilung = (oldName: string, newName: string) => {\n    setMasterAbteilungen((prev) => prev.map((a) => (a === oldName ? newName : a)).sort());\n    setContacts((prev) =>\n      prev.map((c) => (c.abteilung === oldName ? { ...c, abteilung: newName } : c))\n    );\n    addToast(`Abteilung \"${oldName}\" in \"${newName}\" umbenannt.`);\n  };\n\n  const handleDeleteAbteilung = (name: string) => {\n    setMasterAbteilungen((prev) => prev.filter((a) => a !== name));\n    addToast(`Abteilung \"${name}\" aus Stammdaten entfernt.`, \'info\');\n  };\n\n  // Extract unique locations and departments (combining master data and contacts)\n  const allStandorte = useMemo(() => {\n    const set = new Set<string>([...masterStandorte]);\n    contacts.forEach((c) => {\n      if (c.standort) set.add(c.standort);\n    });\n    return Array.from(set).sort();\n  }, [contacts, masterStandorte]);\n\n  const allAbteilungen = useMemo(() => {\n    const set = new Set<string>([...masterAbteilungen]);\n    contacts.forEach((c) => {\n      if (c.abteilung) set.add(c.abteilung);\n    });\n    return Array.from(set).sort();\n  }, [contacts, masterAbteilungen]);"
    }
