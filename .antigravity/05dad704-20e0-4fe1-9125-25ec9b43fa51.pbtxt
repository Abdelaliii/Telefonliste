    replacement_chunks {
      replacement_content: "import { Contact } from \'../types\';\n\nexport function generateStandaloneHtml(contacts: Contact[], title = \'Telefon- und Kontaktverzeichnis\'): string {\n  const jsonContacts = JSON.stringify(contacts, null, 2);\n\n  return `<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>${title}</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n  <style>\n    @media print {\n      .no-print { display: none !important; }\n      body { background: white !important; color: black !important; padding: 0 !important; }\n      .print-shadow-none { box-shadow: none !important; border: 1px solid #e5e7eb !important; }\n    }\n  </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 min-h-screen antialiased flex flex-col font-sans\">\n\n  <!-- Header -->\n  <header class=\"bg-slate-900 text-white shadow-md no-print\">\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5\">\n      <div class=\"flex flex-col md:flex-row md:items-center md:justify-between gap-4\">\n        <div class=\"flex items-center gap-3\">\n          <div class=\"p-3 bg-blue-600 rounded-xl text-white shadow-lg\">\n            <i class=\"fa-solid fa-address-book text-2xl\"></i>\n          </div>\n          <div>\n            <h1 class=\"text-2xl font-bold tracking-tight text-white\">${title}</h1>\n            <p class=\"text-xs text-slate-400\">Digitale Verwaltungsausgabe \302\267 Lokal & Offline nutzbar</p>\n          </div>\n        </div>\n        <div class=\"flex flex-wrap items-center gap-2\">\n          <button onclick=\"openModal()\" class=\"bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition flex items-center gap-2 shadow-sm\">\n            <i class=\"fa-solid fa-user-plus\"></i> Neuer Kontakt\n          </button>\n          <button onclick=\"exportJson()\" class=\"bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 px-3 py-2 rounded-lg text-sm font-medium transition flex items-center gap-1.5\">\n            <i class=\"fa-solid fa-download text-blue-400\"></i> JSON Export\n          </button>\n          <label class=\"bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 px-3 py-2 rounded-lg text-sm font-medium transition flex items-center gap-1.5 cursor-pointer\">\n            <i class=\"fa-solid fa-upload text-green-400\"></i> JSON Import\n            <input type=\"file\" id=\"importFile\" accept=\".json\" onchange=\"importJson(event)\" class=\"hidden\">\n          </label>\n          <button onclick=\"window.print()\" class=\"bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 px-3 py-2 rounded-lg text-sm font-medium transition flex items-center gap-1.5\">\n            <i class=\"fa-solid fa-print\"></i> Drucken\n          </button>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  <!-- Content -->\n  <main class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-1 w-full\">\n    \n    <!-- Controls & Filters -->\n    <div class=\"bg-white p-4 rounded-xl shadow-sm border border-slate-200 mb-6 no-print space-y-4\">\n      <div class=\"flex flex-col md:flex-row gap-3\">\n        <!-- Search input -->\n        <div class=\"relative flex-1\">\n          <i class=\"fa-solid fa-magnifying-glass absolute left-3.5 top-3 text-slate-400\"></i>\n          <input type=\"text\" id=\"searchInput\" oninput=\"render()\" placeholder=\"Suche nach Name, Abteilung, Position, Telefon oder Email...\" class=\"w-full pl-10 pr-4 py-2 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition\">\n        </div>\n        <!-- Location filter -->\n        <div class=\"w-full md:w-64\">\n          <select id=\"locationSelect\" onchange=\"render()\" class=\"w-full py-2 px-3 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition\">\n            <option value=\"\">Alle Standorte</option>\n          </select>\n        </div>\n        <!-- View mode -->\n        <div class=\"flex items-center gap-1 border border-slate-200 p-1 rounded-lg bg-slate-50\">\n          <button id=\"viewBtnTable\" onclick=\"setViewMode(\'table\')\" class=\"px-3 py-1.5 rounded text-xs font-medium bg-white text-slate-800 shadow-sm border border-slate-200\">\n            <i class=\"fa-solid fa-table-list mr-1\"></i> Tabelle\n          </button>\n          <button id=\"viewBtnCards\" onclick=\"setViewMode(\'cards\')\" class=\"px-3 py-1.5 rounded text-xs font-medium text-slate-600 hover:text-slate-900\">\n            <i class=\"fa-solid fa-id-card mr-1\"></i> Karten\n          </button>\n        </div>\n      </div>\n\n      <!-- Quick Stats & Active Filter Info -->\n      <div class=\"flex items-center justify-between text-xs text-slate-500 pt-2 border-t border-slate-100\">\n        <span id=\"counterText\">0 Kontakte geladen</span>\n        <button onclick=\"resetFilters()\" class=\"text-blue-600 hover:underline\">Filter zur\303\274cksetzen</button>\n      </div>\n    </div>\n\n    <!-- Contact List Container -->\n    <div id=\"contactContainer\"></div>\n\n  </main>\n\n  <!-- Modal Form -->\n  <div id=\"modal\" class=\"fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center hidden no-print p-4 overflow-y-auto\">\n    <div class=\"bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-200 my-8\">\n      <div class=\"flex justify-between items-center pb-3 border-b border-slate-100\">\n        <h3 id=\"modalTitle\" class=\"text-lg font-semibold text-slate-900\">Kontakt hinzuf\303\274gen</h3>\n        <button onclick=\"closeModal()\" class=\"text-slate-400 hover:text-slate-600 p-1\">\n          <i class=\"fa-solid fa-xmark text-lg\"></i>\n        </button>\n      </div>\n      <form id=\"contactForm\" onsubmit=\"saveContact(event)\" class=\"space-y-4 pt-4\">\n        <input type=\"hidden\" id=\"editId\">\n        \n        <div class=\"grid grid-cols-2 gap-3\">\n          <div>\n            <label class=\"block text-xs font-medium text-slate-700 mb-1\">Vorname *</label>\n            <input type=\"text\" id=\"inputVorname\" required class=\"w-full p-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none\">\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-slate-700 mb-1\">Nachname *</label>\n            <input type=\"text\" id=\"inputNachname\" required class=\"w-full p-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none\">\n          </div>\n        </div>\n\n        <div>\n          <label class=\"block text-xs font-medium text-slate-700 mb-1\">Standort *</label>\n          <input type=\"text\" id=\"inputStandort\" required list=\"standorteList\" placeholder=\"z.B. Rathaus Hauptgeb\303\244ude\" class=\"w-full p-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none\">\n          <datalist id=\"standorteList\"></datalist>\n        </div>\n\n        <div class=\"grid grid-cols-2 gap-3\">\n          <div>\n            <label class=\"block text-xs font-medium text-slate-700 mb-1\">Position / Rolle *</label>\n            <input type=\"text\" id=\"inputPosition\" required placeholder=\"z.B. Sachbearbeiter\" class=\"w-full p-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none\">\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-slate-700 mb-1\">Abteilung *</label>\n            <input type=\"text\" id=\"inputAbteilung\" required placeholder=\"z.B. B\303\274rgerb\303\274ro\" class=\"w-full p-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none\">\n          </div>\n        </div>\n\n        <div class=\"grid grid-cols-2 gap-3\">\n          <div>\n            <label class=\"block text-xs font-medium text-slate-700 mb-1\">Festnetznummer *</label>\n            <input type=\"text\" id=\"inputFestnetz\" required placeholder=\"0221 500-123\" class=\"w-full p-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none\">\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-slate-700 mb-1\">Mobilnummer (optional)</label>\n            <input type=\"text\" id=\"inputMobil\" placeholder=\"0171 1234567\" class=\"w-full p-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none\">\n          </div>\n        </div>\n\n        <div class=\"grid grid-cols-2 gap-3\">\n          <div>\n            <label class=\"block text-xs font-medium text-slate-700 mb-1\">Email-Adresse *</label>\n            <input type=\"email\" id=\"inputEmail\" required placeholder=\"name@verwaltung.de\" class=\"w-full p-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none\">\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-slate-700 mb-1\">Raum / B\303\274ro</label>\n            <input type=\"text\" id=\"inputRaum\" placeholder=\"Raum 101\" class=\"w-full p-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none\">\n          </div>\n        </div>\n\n        <div>\n          <label class=\"block text-xs font-medium text-slate-700 mb-1\">Notizen / Erreichbarkeit</label>\n          <textarea id=\"inputNotizen\" rows=\"2\" placeholder=\"Zus\303\244tzliche Hinweise...\" class=\"w-full p-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none\"></textarea>\n        </div>\n\n        <div class=\"flex justify-end gap-2 pt-3 border-t border-slate-100\">\n          <button type=\"button\" onclick=\"closeModal()\" class=\"px-4 py-2 border border-slate-300 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-50\">Abbrechen</button>\n          <button type=\"submit\" class=\"px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium shadow-sm\">Speichern</button>\n        </div>\n      </form>\n    </div>\n  </div>\n\n  <footer class=\"bg-white border-t border-slate-200 py-4 text-center text-xs text-slate-500 no-print mt-auto\">\n    ${title} \302\267 Standalone-Ausgabe \302\267 Speicherung erfolgt automatisch im lokalen Browser-Speicher (localStorage)\n  </footer>\n\n  <script>\n    const INITIAL_DATA = ${jsonContacts};\n    const STORAGE_KEY = \'telefonverzeichnis_contacts_v1\';\n    let viewMode = \'table\';\n\n    function getContacts() {\n      const stored = localStorage.getItem(STORAGE_KEY);\n      if (stored) {\n        try { return JSON.parse(stored); } catch(e) {}\n      }\n      localStorage.setItem(STORAGE_KEY, JSON.stringify(INITIAL_DATA));\n      return INITIAL_DATA;\n    }\n\n    function saveContacts(data) {\n      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));\n      updateLocationSelect();\n      render();\n    }\n\n    function setViewMode(mode) {\n      viewMode = mode;\n      document.getElementById(\'viewBtnTable\').className = mode === \'table\' ? \'px-3 py-1.5 rounded text-xs font-medium bg-white text-slate-800 shadow-sm border border-slate-200\' : \'px-3 py-1.5 rounded text-xs font-medium text-slate-600 hover:text-slate-900\';\n      document.getElementById(\'viewBtnCards\').className = mode === \'cards\' ? \'px-3 py-1.5 rounded text-xs font-medium bg-white text-slate-800 shadow-sm border border-slate-200\' : \'px-3 py-1.5 rounded text-xs font-medium text-slate-600 hover:text-slate-900\';\n      render();\n    }\n\n    function updateLocationSelect() {\n      const contacts = getContacts();\n      const locations = [...new Set(contacts.map(c => c.standort))].sort();\n      const select = document.getElementById(\'locationSelect\');\n      const datalist = document.getElementById(\'standorteList\');\n      const currentVal = select.value;\n      \n      select.innerHTML = \'<option value=\"\">Alle Standorte</option>\' + locations.map(l => \\`<option value=\"\\${l}\">\\${l}</option>\\`).join(\'\');\n      select.value = currentVal;\n\n      datalist.innerHTML = locations.map(l => \\`<option value=\"\\${l}\">\\`).join(\'\');\n    }\n\n    function render() {\n      const contacts = getContacts();\n      const search = document.getElementById(\'searchInput\').value.toLowerCase().trim();\n      const location = document.getElementById(\'locationSelect\').value;\n\n      const filtered = contacts.filter(c => {\n        const matchesLocation = !location || c.standort === location;\n        const matchesSearch = !search || \n          (c.nachname + \' \' + c.vorname).toLowerCase().includes(search) ||\n          (c.abteilung || \'\').toLowerCase().includes(search) ||\n          (c.position || \'\').toLowerCase().includes(search) ||\n          (c.festnetz || \'\').toLowerCase().includes(search) ||\n          (c.mobil || \'\').toLowerCase().includes(search) ||\n          (c.email || \'\').toLowerCase().includes(search) ||\n          (c.standort || \'\').toLowerCase().includes(search);\n        return matchesLocation && matchesSearch;\n      });\n\n      document.getElementById(\'counterText\').innerText = \\`Zeige \\${filtered.length} von \\${contacts.length} Kontakten\\`;\n\n      const container = document.getElementById(\'contactContainer\');\n\n      if (filtered.length === 0) {\n        container.innerHTML = \\`\n          <div class=\"bg-white rounded-xl p-12 text-center border border-slate-200 shadow-sm\">\n            <i class=\"fa-solid fa-address-book text-4xl text-slate-300 mb-3\"></i>\n            <h3 class=\"text-base font-semibold text-slate-700\">Keine Kontakte gefunden</h3>\n            <p class=\"text-xs text-slate-500 mt-1\">Versuche die Suchbegriffe oder Filter anzupassen.</p>\n          </div>\n        \\`;\n        return;\n      }\n\n      if (viewMode === \'table\') {\n        let html = \\`\n          <div class=\"bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden print-shadow-none\">\n            <div class=\"overflow-x-auto\">\n              <table class=\"w-full text-left text-sm\">\n                <thead class=\"bg-slate-100 text-slate-600 font-medium text-xs uppercase tracking-wider border-b border-slate-200\">\n                  <tr>\n                    <th class=\"px-4 py-3\">Name / Position</th>\n                    <th class=\"px-4 py-3\">Standort / Abteilung</th>\n                    <th class=\"px-4 py-3\">Festnetz</th>\n                    <th class=\"px-4 py-3\">Mobil</th>\n                    <th class=\"px-4 py-3\">Email</th>\n                    <th class=\"px-4 py-3 text-right no-print\">Aktionen</th>\n                  </tr>\n                </thead>\n                <tbody class=\"divide-y divide-slate-200 bg-white\">\n        \\`;\n\n        filtered.forEach(c => {\n          html += \\`\n            <tr class=\"hover:bg-slate-50/80 transition\">\n              <td class=\"px-4 py-3\">\n                <div class=\"font-semibold text-slate-900\">\\${c.nachname}, \\${c.vorname}</div>\n                <div class=\"text-xs text-slate-500\">\\${c.position || \'-\'}</div>\n              </td>\n              <td class=\"px-4 py-3\">\n                <span class=\"inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-50 text-blue-700 border border-blue-200 mb-0.5\">\n                  \\${c.standort}\n                </span>\n                <div class=\"text-xs text-slate-500\">\\${c.abteilung || \'-\'} \\${c.raum ? \'\302\267 \' + c.raum : \'\'}</div>\n              </td>\n              <td class=\"px-4 py-3 font-mono text-xs\">\n                <a href=\"tel:\\${c.festnetz}\" class=\"text-blue-600 hover:underline flex items-center gap-1\">\n                  <i class=\"fa-solid fa-phone text-slate-400\"></i> \\${c.festnetz}\n                </a>\n              </td>\n              <td class=\"px-4 py-3 font-mono text-xs\">\n                \\${c.mobil ? \\`<a href=\"tel:\\${c.mobil}\" class=\"text-blue-600 hover:underline flex items-center gap-1\"><i class=\"fa-solid fa-mobile-screen text-slate-400\"></i> \\${c.mobil}</a>\\` : \'<span class=\"text-slate-300\">-</span>\'}\n              </td>\n              <td class=\"px-4 py-3 text-xs\">\n                <a href=\"mailto:\\${c.email}\" class=\"text-slate-700 hover:text-blue-600 hover:underline flex items-center gap-1\">\n                  <i class=\"fa-regular fa-envelope text-slate-400\"></i> \\${c.email}\n                </a>\n              </td>\n              <td class=\"px-4 py-3 text-right no-print whitespace-nowrap\">\n                <button onclick=\"editContact(\'\\${c.id}\')\" class=\"text-slate-500 hover:text-blue-600 p-1.5 rounded hover:bg-slate-100 mr-1\" title=\"Bearbeiten\">\n                  <i class=\"fa-solid fa-pen-to-square\"></i>\n                </button>\n                <button onclick=\"deleteContact(\'\\${c.id}\')\" class=\"text-slate-500 hover:text-red-600 p-1.5 rounded hover:bg-slate-100\" title=\"L\303\266schen\">\n                  <i class=\"fa-solid fa-trash\"></i>\n                </button>\n              </td>\n            </tr>\n          \\`;\n        });\n\n        html += \\`\n                </tbody>\n              </table>\n            </div>\n          </div>\n        \\`;\n        container.innerHTML = html;\n      } else {\n        let html = \\`<div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\\`;\n        filtered.forEach(c => {\n          html += \\`\n            <div class=\"bg-white rounded-xl p-5 shadow-sm border border-slate-200 hover:shadow-md transition flex flex-col justify-between print-shadow-none\">\n              <div>\n                <div class=\"flex justify-between items-start gap-2 mb-2\">\n                  <div>\n                    <h4 class=\"font-bold text-slate-900 text-base\">\\${c.nachname}, \\${c.vorname}</h4>\n                    <p class=\"text-xs font-medium text-blue-600\">\\${c.position}</p>\n                  </div>\n                  <span class=\"inline-block px-2 py-0.5 text-[11px] font-medium bg-slate-100 text-slate-700 rounded border border-slate-200\">\n                    \\${c.standort}\n                  </span>\n                </div>\n\n                <p class=\"text-xs text-slate-500 mb-3\"><i class=\"fa-solid fa-sitemap text-slate-400 mr-1\"></i> \\${c.abteilung} \\${c.raum ? \' (\' + c.raum + \')\' : \'\'}</p>\n\n                <div class=\"space-y-1.5 pt-3 border-t border-slate-100 text-xs font-mono\">\n                  <a href=\"tel:\\${c.festnetz}\" class=\"flex items-center gap-2 text-slate-700 hover:text-blue-600\">\n                    <i class=\"fa-solid fa-phone text-blue-500 w-4\"></i> \\${c.festnetz}\n                  </a>\n                  \\${c.mobil ? \\`\n                    <a href=\"tel:\\${c.mobil}\" class=\"flex items-center gap-2 text-slate-700 hover:text-blue-600\">\n                      <i class=\"fa-solid fa-mobile-screen text-emerald-500 w-4\"></i> \\${c.mobil}\n                    </a>\n                  \\` : \'\'}\n                  <a href=\"mailto:\\${c.email}\" class=\"flex items-center gap-2 text-slate-700 hover:text-blue-600 font-sans truncate\">\n                    <i class=\"fa-regular fa-envelope text-amber-500 w-4\"></i> \\${c.email}\n                  </a>\n                </div>\n\n                \\${c.notizen ? \\`<p class=\"text-[11px] text-slate-500 bg-slate-50 p-2 rounded mt-3 italic\">\\${c.notizen}</p>\\` : \'\'}\n              </div>\n\n              <div class=\"flex justify-end gap-2 pt-4 mt-3 border-t border-slate-100 no-print\">\n                <button onclick=\"editContact(\'\\${c.id}\')\" class=\"px-3 py-1.5 bg-slate-100 hover:bg-blue-50 text-slate-700 hover:text-blue-600 text-xs rounded font-medium transition flex items-center gap-1\">\n                  <i class=\"fa-solid fa-pen-to-square\"></i> Bearbeiten\n                </button>\n                <button onclick=\"deleteContact(\'\\${c.id}\')\" class=\"px-3 py-1.5 bg-slate-100 hover:bg-red-50 text-slate-700 hover:text-red-600 text-xs rounded font-medium transition flex items-center gap-1\">\n                  <i class=\"fa-solid fa-trash\"></i> L\303\266schen\n                </button>\n              </div>\n            </div>\n          \\`;\n        });\n        html += \\`</div>\\`;\n        container.innerHTML = html;\n      }\n    }\n\n    function openModal(id = null) {\n      document.getElementById(\'editId\').value = id || \'\';\n      document.getElementById(\'modalTitle\').innerText = id ? \'Kontakt bearbeiten\' : \'Neuer Kontakt\';\n      \n      if (id) {\n        const contacts = getContacts();\n        const c = contacts.find(item => item.id === id);\n        if (c) {\n          document.getElementById(\'inputVorname\').value = c.vorname || \'\';\n          document.getElementById(\'inputNachname\').value = c.nachname || \'\';\n          document.getElementById(\'inputStandort\').value = c.standort || \'\';\n          document.getElementById(\'inputPosition\').value = c.position || \'\';\n          document.getElementById(\'inputAbteilung\').value = c.abteilung || \'\';\n          document.getElementById(\'inputFestnetz\').value = c.festnetz || \'\';\n          document.getElementById(\'inputMobil\').value = c.mobil || \'\';\n          document.getElementById(\'inputEmail\').value = c.email || \'\';\n          document.getElementById(\'inputRaum\').value = c.raum || \'\';\n          document.getElementById(\'inputNotizen\').value = c.notizen || \'\';\n        }\n      } else {\n        document.getElementById(\'contactForm\').reset();\n      }\n      \n      document.getElementById(\'modal\').classList.remove(\'hidden\');\n    }\n\n    function closeModal() {\n      document.getElementById(\'modal\').classList.add(\'hidden\');\n    }\n\n    function saveContact(e) {\n      e.preventDefault();\n      const id = document.getElementById(\'editId\').value;\n      const contacts = getContacts();\n\n      const newContact = {\n        id: id || (\'c-\' + Date.now()),\n        vorname: document.getElementById(\'inputVorname\').value.trim(),\n        nachname: document.getElementById(\'inputNachname\').value.trim(),\n        standort: document.getElementById(\'inputStandort\').value.trim(),\n        position: document.getElementById(\'inputPosition\').value.trim(),\n        abteilung: document.getElementById(\'inputAbteilung\').value.trim(),\n        festnetz: document.getElementById(\'inputFestnetz\').value.trim(),\n        mobil: document.getElementById(\'inputMobil\').value.trim(),\n        email: document.getElementById(\'inputEmail\').value.trim(),\n        raum: document.getElementById(\'inputRaum\').value.trim(),\n        notizen: document.getElementById(\'inputNotizen\').value.trim(),\n        updatedAt: new Date().toISOString()\n      };\n\n      if (id) {\n        const index = contacts.findIndex(item => item.id === id);\n        if (index !== -1) contacts[index] = newContact;\n      } else {\n        contacts.unshift(newContact);\n      }\n\n      saveContacts(contacts);\n      closeModal();\n    }\n\n    function editContact(id) {\n      openModal(id);\n    }\n\n    function deleteContact(id) {\n      if (confirm(\'M\303\266chten Sie diesen Kontakt wirklich l\303\266schen?\')) {\n        const contacts = getContacts().filter(item => item.id !== id);\n        saveContacts(contacts);\n      }\n    }\n\n    function resetFilters() {\n      document.getElementById(\'searchInput\').value = \'\';\n      document.getElementById(\'locationSelect\').value = \'\';\n      render();\n    }\n\n    function exportJson() {\n      const dataStr = \"data:text/json;charset=utf-8,\" + encodeURIComponent(JSON.stringify(getContacts(), null, 2));\n      const anchor = document.createElement(\'a\');\n      anchor.setAttribute(\"href\", dataStr);\n      anchor.setAttribute(\"download\", \"telefonverzeichnis_kontakte.json\");\n      document.body.appendChild(anchor);\n      anchor.click();\n      anchor.remove();\n    }\n\n    function importJson(event) {\n      const file = event.target.files[0];\n      if (!file) return;\n\n      const reader = new FileReader();\n      reader.onload = function(e) {\n        try {\n          const imported = JSON.parse(e.target.result);\n          if (Array.isArray(imported)) {\n            if (confirm(\\`M\303\266chten Sie \\${imported.length} Kontakte importieren? Vorhandene Daten werden \303\274berschrieben.\\`)) {\n              saveContacts(imported);\n              alert(\'Import erfolgreich abgeschlossen!\');\n            }\n          } else {\n            alert(\'Ung\303\274ltiges Format: Die JSON-Datei muss ein Array von Kontakten enthalten.\');\n          }\n        } catch (err) {\n          alert(\'Fehler beim Lesen der JSON-Datei: \' + err.message);\n        }\n      };\n      reader.readAsText(file);\n    }\n\n    // Init\n    updateLocationSelect();\n    render();\n  </script>\n</body>\n</html>`;\n}\n"
    }
