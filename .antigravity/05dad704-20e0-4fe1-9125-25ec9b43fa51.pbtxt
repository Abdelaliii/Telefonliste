      original_chunk {
        target_content: "          <div>\n            <label class=\"block text-xs font-medium text-slate-700 mb-1\">Abteilung *</label>\n            <input type=\"text\" id=\"inputAbteilung\" required placeholder=\"z.B. B\303\274rgerb\303\274ro\" class=\"w-full p-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none\">\n          </div>\n        </div>\n\n        <div class=\"grid grid-cols-2 gap-3\">\n          <div>\n            <label class=\"block text-xs font-medium text-slate-700 mb-1\">Festnetznummer *</label>\n            <input type=\"text\" id=\"inputFestnetz\" required placeholder=\"0221 500-123\" class=\"w-full p-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none\">\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-slate-700 mb-1\">Mobilnummer (optional)</label>\n            <input type=\"text\" id=\"inputMobil\" placeholder=\"0171 1234567\" class=\"w-full p-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none\">\n          </div>\n        </div>\n\n        <div class=\"grid grid-cols-2 gap-3\">\n          <div>\n            <label class=\"block text-xs font-medium text-slate-700 mb-1\">Email-Adresse *</label>\n            <input type=\"email\" id=\"inputEmail\" required placeholder=\"name@verwaltung.de\" class=\"w-full p-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none\">\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-slate-700 mb-1\">Raum / B\303\274ro</label>\n            <input type=\"text\" id=\"inputRaum\" placeholder=\"Raum 101\" class=\"w-full p-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none\">\n          </div>\n        </div>\n\n        <div>\n          <label class=\"block text-xs font-medium text-slate-700 mb-1\">Notizen / Erreichbarkeit</label>\n          <textarea id=\"inputNotizen\" rows=\"2\" placeholder=\"Zus\303\244tzliche Hinweise...\" class=\"w-full p-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none\"></textarea>\n        </div>\n\n        <div class=\"flex justify-end gap-2 pt-3 border-t border-slate-100\">\n          <button type=\"button\" onclick=\"closeModal()\" class=\"px-4 py-2 border border-slate-300 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-50\">Abbrechen</button>\n          <button type=\"submit\" class=\"px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium shadow-sm\">Speichern</button>\n        </div>\n      </form>\n    </div>\n  </div>"
        replacement_content: "          <div>\n            <label class=\"block text-xs font-medium text-slate-700 mb-1\">Abteilung *</label>\n            <input type=\"text\" id=\"inputAbteilung\" required list=\"abteilungenList\" placeholder=\"z.B. B\303\274rgerb\303\274ro\" class=\"w-full p-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none\">\n            <datalist id=\"abteilungenList\"></datalist>\n          </div>\n        </div>\n\n        <div class=\"grid grid-cols-2 gap-3\">\n          <div>\n            <label class=\"block text-xs font-medium text-slate-700 mb-1\">Festnetznummer *</label>\n            <input type=\"text\" id=\"inputFestnetz\" required placeholder=\"0221 500-123\" class=\"w-full p-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none\">\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-slate-700 mb-1\">Mobilnummer (optional)</label>\n            <input type=\"text\" id=\"inputMobil\" placeholder=\"0171 1234567\" class=\"w-full p-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none\">\n          </div>\n        </div>\n\n        <div class=\"grid grid-cols-2 gap-3\">\n          <div>\n            <label class=\"block text-xs font-medium text-slate-700 mb-1\">Email-Adresse *</label>\n            <input type=\"email\" id=\"inputEmail\" required placeholder=\"name@verwaltung.de\" class=\"w-full p-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none\">\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-slate-700 mb-1\">Raum / B\303\274ro</label>\n            <input type=\"text\" id=\"inputRaum\" placeholder=\"Raum 101\" class=\"w-full p-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none\">\n          </div>\n        </div>\n\n        <div>\n          <label class=\"block text-xs font-medium text-slate-700 mb-1\">Notizen / Erreichbarkeit</label>\n          <textarea id=\"inputNotizen\" rows=\"2\" placeholder=\"Zus\303\244tzliche Hinweise...\" class=\"w-full p-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none\"></textarea>\n        </div>\n\n        <div class=\"flex justify-end gap-2 pt-3 border-t border-slate-100\">\n          <button type=\"button\" onclick=\"closeModal()\" class=\"px-4 py-2 border border-slate-300 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-50\">Abbrechen</button>\n          <button type=\"submit\" class=\"px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium shadow-sm\">Speichern</button>\n        </div>\n      </form>\n    </div>\n  </div>\n\n  <!-- Master Data Modal -->\n  <div id=\"masterModal\" class=\"fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center hidden no-print p-4 overflow-y-auto\">\n    <div class=\"bg-white rounded-2xl max-w-2xl w-full p-6 shadow-2xl border border-slate-200 my-8\">\n      <div class=\"flex justify-between items-center pb-4 border-b border-slate-100\">\n        <div class=\"flex items-center gap-3\">\n          <div class=\"p-2.5 bg-indigo-50 text-indigo-600 rounded-xl\">\n            <i class=\"fa-solid fa-building text-lg\"></i>\n          </div>\n          <div>\n            <h3 class=\"text-lg font-bold text-slate-900\">Stammdaten-Verwaltung</h3>\n            <p class=\"text-xs text-slate-500\">Zentrale Pflege von Standorten und Abteilungen</p>\n          </div>\n        </div>\n        <button onclick=\"closeMasterModal()\" class=\"text-slate-400 hover:text-slate-600 p-2 rounded-lg hover:bg-slate-100\">\n          <i class=\"fa-solid fa-xmark text-lg\"></i>\n        </button>\n      </div>\n\n      <!-- Tab Buttons -->\n      <div class=\"flex border-b border-slate-200 mt-4\">\n        <button id=\"masterTabStandorte\" onclick=\"switchMasterTab(\'standorte\')\" class=\"flex items-center gap-2 py-3 px-4 font-semibold text-sm border-b-2 border-indigo-600 text-indigo-600\">\n          <i class=\"fa-solid fa-building\"></i> <span id=\"masterStandorteCount\">Standorte</span>\n        </button>\n        <button id=\"masterTabAbteilungen\" onclick=\"switchMasterTab(\'abteilungen\')\" class=\"flex items-center gap-2 py-3 px-4 font-medium text-sm border-b-2 border-transparent text-slate-500 hover:text-slate-800\">\n          <i class=\"fa-solid fa-layer-group\"></i> <span id=\"masterAbteilungenCount\">Abteilungen</span>\n        </button>\n      </div>\n\n      <!-- Add Form -->\n      <form onsubmit=\"addMasterItem(event)\" class=\"mt-4 flex gap-2\">\n        <input type=\"text\" id=\"newMasterInput\" placeholder=\"Neuen Eintrag hinzuf\303\274gen...\" class=\"flex-1 px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500\">\n        <button type=\"submit\" class=\"bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-2.5 rounded-xl text-sm font-semibold flex items-center gap-1.5 transition shadow-sm\">\n          <i class=\"fa-solid fa-plus\"></i> Hinzuf\303\274gen\n        </button>\n      </form>\n\n      <!-- Search Filter -->\n      <div class=\"mt-4 relative\">\n        <i class=\"fa-solid fa-magnifying-glass absolute left-3 top-3 text-slate-400 text-xs\"></i>\n        <input type=\"text\" id=\"masterSearchInput\" oninput=\"renderMasterList()\" placeholder=\"Eintr\303\244ge durchsuchen...\" class=\"w-full pl-9 pr-4 py-2 rounded-xl border border-slate-200 text-xs text-slate-700 bg-slate-50 focus:outline-none focus:bg-white focus:border-indigo-500\">\n      </div>\n\n      <!-- Item List Container -->\n      <div id=\"masterListContainer\" class=\"mt-3 max-h-72 overflow-y-auto border border-slate-200 rounded-xl divide-y divide-slate-100 bg-white\"></div>\n\n      <div class=\"mt-6 pt-4 border-t border-slate-100 flex justify-end\">\n        <button onclick=\"closeMasterModal()\" class=\"px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 hover:bg-slate-100 font-medium text-sm transition\">\n          Schlie\303\237en\n        </button>\n      </div>\n    </div>\n  </div>"
