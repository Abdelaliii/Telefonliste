        lines {
          text: "    function downloadVCardFile() {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      if (!vCardContact) return;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
