  setStandort(\'__custom__\');\n        setCustomStandort(editingContact.standort || \'\');\n      }\n\n      setPosition(editingContact.position || \'\');\n\n      if (masterData.abteilungen.includes(editingContact.abteilung)) {\n        setAbteilung(editingContact.abteilung);\n        setCustomAbteilung(\'\');\n      } else {\n        setAbteilung(\'__custom__\');\n        setCustomAbteilung(editingContact.abteilung || \'\');\n      }\n\n      setFestnetz(editingContact.festnetz || \'\');\n      setMobil(editingContact.mobil || \'\');\n      setEmail(editingContact.email || \'\');\n      setRaum(editingContact.raum || \'\');\n      setNotizen(editingContact.notizen || \'\');\n    } else {\n      setVorname(\'\');\n      setNachname(\'\');\n      setStandort(masterData.standorte[0] || \'\');\n      setCustomStandort(\'\');\n      setPosition(\'\');\n      setAbteilung(masterData.abteilungen[0] || \'\');\n      setCustomAbteilung(\'\');\n      setFestnetz(\'\');\n      setMobil(\'\');\n      setEmail(\'\');\n      setRaum(\'\');\n      setNotizen(\'\');\n    }\n  }, [editingContact, isOpen, masterData]);\n\n  if (!isOpen) return null;\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    const finalStandort = standort === \'__custom__\' ? customStandort.trim() : standort;\n    const finalAbteilung = abteilung === \'__custom__\' ? customAbteilung.trim() : abteilung;\n\n    onSave({\n      id: editingContact?.id,\n      vorname: vorname.trim(),\n      nachname: nachname.trim(),\n      standort: finalStandort,\n      position: position.trim(),\n      abteilung: finalAbteilung,\n      festnetz: festnetz.trim(),\n      mobil: mobil.trim(),\n      email: email.trim(),\n      raum: raum.trim(),\n      notizen: notizen.trim(),\n      isFavorite: editingContact?.isFavorite || false,\n      updatedAt: new Date().toISOString(),\n    });\n  };\n\n  return (\n    <div className=\"fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 overflow-y-auto no-print\">\n      <div className=\"bg-white rounded-2xl max-w-xl w-full p-6 shadow-2xl border border-slate-200 my-8 animate-in fade-in zoom-in-95 duration-150\">\n        \n        {/* Modal Header */}\n        <div className=\"flex justify-between items-center pb-4 border-b border-slate-100\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"p-2.5 bg-blue-50 text-blue-600 rounded-xl\">\n              <User className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h2 className=\"text-lg font-bold text-slate-900\">\n                {editingContact ? \'Kontakt bearbeiten\' : \'Neuen Kontakt anlegen\'}\n              </h2>\n              <p className=\"text-xs text-slate-500\">\n                Verwende vordefinierte Stammdaten f\303\274r gepr\303\274fte Datenqualit\303\244t\n              </p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"text-slate-400 hover:text-slate-600 p-1.5 rounded-lg hover:bg-slate-100 transition\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Modal Form */}\n        <form onSubmit={handleSubmit} className=\"space-y-4 pt-4\">\n          \n          {/* Vorname & Nachname */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                Vorname *\n              </label>\n              <input\n                type=\"text\"\n                required\n                value={vorname}\n                onChange={(e) => setVorname(e.target.value)}\n                placeholder=\"z.B. Maria\"\n                className=\"w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                Nachname *\n              </label>\n              <input\n                type=\"text\"\n                required\n                value={nachname}\n                onChange={(e) => setNachname(e.target.value)}\n                placeholder=\"z.B. Schmidt\"\n                className=\"w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition\"\n              />\n            </div>\n          </div>\n\n          {/* Standort Selection from Master Data */}\n          <div>\n            <label className=\"block text-xs font-semibold text-slate-700 mb-1 flex items-center gap-1\">\n              <MapPin className=\"w-3.5 h-3.5 text-blue-500\" />\n              Standort (Zentrale Stammdaten) *\n            </label>\n            <select\n              value={standort}\n              onChange={(e) => setStandort(e.target.value)}\n              className=\"w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition cursor-pointer\"\n            >\n              {masterData.standorte.map((loc) => (\n                <option key={loc} value={loc}>\n                  {loc}\n                </option>\n              ))}\n              <option value=\"__custom__\">+ Neuen Standort eingeben...</option>\n            </select>\n\n            {standort === \'__custom__\' && (\n              <input\n                type=\"text\"\n                required\n                value={customStandort}\n                onChange={(e) => setCustomStandort(e.target.value)}\n                placeholder=\"Eigener Standort Name...\"\n                className=\"w-full mt-2 px-3 py-2 bg-amber-50/50 border border-amber-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 transition\"\n              />\n            )}\n          </div>\n\n          {/* Position & Abteilung */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                Position / Rolle *\n              </label>\n              <input\n                type=\"text\"\n                required\n                value={position}\n                onChange={(e) => setPosition(e.target.value)}\n                placeholder=\"z.B. Projektleiter\"\n                className=\"w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-700 mb-1 flex items-center gap-1\">\n                <Building className=\"w-3.5 h-3.5 text-slate-400\" />\n                Abteilung (Stammdaten) *\n              </label>\n              <select\n                value={abteilung}\n                onChange={(e) => setAbteilung(e.target.value)}\n                className=\"w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition cursor-pointer\"\n              >\n                {masterData.abteilungen.map((dept) => (\n                  <option key={dept} value={dept}>\n                    {dept}\n                  </option>\n                ))}\n                <option value=\"__custom__\">+ Neue Abteilung eingeben...</option>\n              </select>\n\n              {abteilung === \'__custom__\' && (\n                <input\n                  type=\"text\"\n                  required\n                  value={customAbteilung}\n                  onChange={(e) => setCustomAbteilung(e.target.value)}\n                  placeholder=\"Eigene Abteilung Name...\"\n                  